@model GameStoreMVC.Models.Game
@{
    ViewData["Title"] = "Cadastrar Novo Game";
}

<div class="d-flex justify-content-center align-items-center py-5">
    <div class="form-card" style="max-width:560px;">
        <h2 class="text-center">Novo Game</h2>
        <p class="subtitle text-center mb-4">Adicione um novo titulo ao seu arsenal</p>

        <form asp-action="Criar" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Titulo" class="form-label">Titulo do Jogo</label>
                <input asp-for="Titulo" class="form-control" placeholder="Ex: Elden Ring" />
                <span asp-validation-for="Titulo" class="text-validation"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descricao" class="form-label">Descricao Curta</label>
                <textarea asp-for="Descricao" class="form-control" rows="3" placeholder="Breve resumo do game"></textarea>
                <span asp-validation-for="Descricao" class="text-validation"></span>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label asp-for="Preco" class="form-label">Preco (R$)</label>
                    <input asp-for="Preco" class="form-control" type="number" step="0.01" min="0" placeholder="0,00" />
                    <span asp-validation-for="Preco" class="text-validation"></span>
                </div>
                <div class="col-6">
                    <label asp-for="Categoria" class="form-label">Categoria</label>
                    <select asp-for="Categoria" class="form-select">
                        <option value="RPG">RPG</option>
                        <option value="Acao">Acao</option>
                        <option value="Corrida">Corrida</option>
                        <option value="Aventura">Aventura</option>
                        <option value="Estrategia">Estrategia</option>
                        <option value="Esportes">Esportes</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="UrlCapa" class="form-label">URL da Capa</label>
                <input asp-for="UrlCapa" class="form-control" placeholder="https://..." />
                <span asp-validation-for="UrlCapa" class="text-validation"></span>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="Destaque" class="form-check-input" type="checkbox" />
                <label asp-for="Destaque" class="form-check-label" style="color:#cbd5e1;">Marcar como Destaque</label>
            </div>
            <div class="d-flex gap-3">
                <button type="submit" class="btn-primary-custom">Salvar Game</button>
                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-outline-secondary flex-fill text-center" style="border-radius:8px;padding:12px;">Voltar</a>
            </div>
        </form>
    </div>
</div>
