@model GameStoreMVC.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center py-5">
    <div class="form-card">
        <h2 class="text-center">Login</h2>
        <p class="subtitle text-center mb-4">Entre para gerenciar seus games</p>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
        {
            <div class="alert-danger-custom mb-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-mail</label>
                <input asp-for="Email" class="form-control" placeholder="nome@exemplo.com" />
                <span asp-validation-for="Email" class="text-validation"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Senha" class="form-label">Senha</label>
                <input asp-for="Senha" type="password" class="form-control" placeholder="Senha" />
                <span asp-validation-for="Senha" class="text-validation"></span>
            </div>
            <button type="submit" class="btn-primary-custom">Acessar Arena</button>
        </form>

        <p class="text-center mt-3" style="font-size:.9rem;color:#94a3b8;">
            Ainda nao tem uma conta?<br />
            <a asp-action="Cadastro" style="color:#a855f7;font-weight:600;">Criar nova conta</a>
        </p>
    </div>
</div>
